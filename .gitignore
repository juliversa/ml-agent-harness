# Competition data, weights and secrets never go in git (RULES R34).
competitions/*/data/*
competitions/*/runs/**
!competitions/*/runs/**/
!competitions/*/runs/**/*.log
!competitions/*/runs/**/*.txt
!competitions/*/runs/**/*.json
!competitions/*/runs/**/*.md
weights/
checkpoints/
*.pt
*.pth
*.ckpt
*.npz
*.mp4
.env
kaggle.json
.tokcache.json
.alerts/
.kfail/
.kstate
.keeper
keeper.log
.lock
.last_running
.tokens_*
*.wav
*.npy
*.parquet
__pycache__/
.claude/settings.json
.claude/settings.local.json

# fixed on day 0 and committed (PLAYBOOK law 3); last, so the *.npy rule above does not win
!competitions/*/data/folds.npy
!competitions/*/data/hard_ids.npy
!competitions/*/data/groups.npy
.obsidian/
