#!/usr/bin/env bash
# Offline stand-in for `claude -p --output-format json`, used by tests/test_gates.py (kit/fanout.py). Never calls a model.
p=$(cat); id=$(printf '%s' "$p" | sed -n 's/^job: //p' | head -1)
[ -n "${FAKE_CLAUDE_LOG:-}" ] && echo "$id" >> "$FAKE_CLAUDE_LOG"
[ -n "${FAKE_CLAUDE_ARGS:-}" ] && echo "$*" >> "$FAKE_CLAUDE_ARGS"
err=false; [ "$id" = "${FAKE_CLAUDE_FAIL:-}" ] && err=true
printf '{"type": "result", "is_error": %s, "result": "read %s", "total_cost_usd": 0.5, "num_turns": 2, "duration_ms": 3000}\n' "$err" "$id"
